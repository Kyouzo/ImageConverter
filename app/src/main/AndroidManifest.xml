<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No READ permission is needed: images are chosen through the Android Photo
      Picker, which returns a readable content URI without any storage grant.

      WRITE_EXTERNAL_STORAGE is requested ONLY on API <= 28, where saving into the
      public Pictures collection via MediaStore still requires it. On API 29+ the
      app saves with scoped storage and no permission at all.
    -->
    <!--
      Deleting the original after a save removes the real file from disk.
        - MANAGE_EXTERNAL_STORAGE ("All files access", Android 11+): granted via a
          Settings screen; lets the app resolve the file path and File.delete() it.
        - WRITE_EXTERNAL_STORAGE (<= API 29): with requestLegacyExternalStorage,
          allows the same file delete on Android 10 and below.
        - READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE: used to resolve the file path
          from MediaStore. None of these are needed to SELECT an image (the Photo
          Picker needs no permission); they are only for deletion.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ImageConverter">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ImageConverter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
